<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">stgsso.cubeone.in</domain>
        <trust-anchors>
            <!-- Trust system certs -->
            <certificates src="system" />
            <!-- Trust bundled certificate -->
            <certificates src="@raw/stgsso" />
        </trust-anchors>
    </domain-config>
</network-security-config>
